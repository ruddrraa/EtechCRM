MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
PORT=3001
# Required only for the one-time initial Super Admin bootstrap endpoint.
BOOTSTRAP_TOKEN=
# Ola Maps API key for address autocomplete proxy
OLA_MAPS_API_KEY=
# Cloudinary credentials for centralized cloud file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Web Push VAPID credentials for desktop & mobile push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@exceltechnologies.in
# Vercel Cron bearer authorization secret (minimum 32 chars required) & follow-up timezone
CRON_SECRET=
FOLLOWUP_TIMEZONE=Asia/Kolkata
# Encrypted MongoDB logical backup key (exact 64-character hex string = 32 bytes; never commit actual values)
BACKUP_ENCRYPTION_KEY=
# Isolated target DB URI for non-destructive restore verification (must differ from MONGODB_URI)
RESTORE_TARGET_MONGODB_URI=
